<!DOCTYPE html>
<html>
<head><title>{{ site.title }}</title></head>
<body>
  <ul>
  <li class="item-1">
  {% include "includes/snippet.liquid" %}
  {% if user.active %}
    <span>{{ user.name }} - item {{ i }} of {{ total }}</span>
  {% else %}
    <span>{{ status | upcase }}</span>
  {% endif %}
  {% for tag in tags %}<em>{{ tag }}</em>{% endfor %}
  <p>{{ post.title | truncate: 40 }} by {{ post.author.name }}, published {{ post.date }}</p>
</li>

